{
  "name": "jtl-connector-tester-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node --test lib/*.test.js",
    "start": "electron .",
    "php:fetch": "./scripts/fetch-php.sh",
    "smoke": "node scripts/smoke.js",
    "prebuild": "cd .. && composer install --no-dev --optimize-autoloader && cd frontend && npm install && npm run build",
    "build:mac": "npm run prebuild && electron-builder --mac zip --arm64 --x64",
    "build:win": "npm run prebuild && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
